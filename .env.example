# ICS31 Quiz Generator - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# REQUIRED: OpenAI API Key
# =============================================================================
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# =============================================================================
# OPTIONAL: Server Configuration
# =============================================================================

# Server port (default: 8000)
# PORT=8000

# Debug mode - set to "true" for development only (default: false)
# DEBUG=false

# Allowed CORS origins (comma-separated, for production)
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# =============================================================================
# SECURITY: Proxy Configuration
# =============================================================================

# Set to "true" ONLY when running behind a trusted reverse proxy (Nginx)
# This allows the app to trust X-Forwarded-For headers for rate limiting
# IMPORTANT: Keep as "false" if app is directly exposed to the internet
TRUST_PROXY=true
